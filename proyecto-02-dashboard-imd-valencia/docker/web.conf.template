server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    location / {
        add_header Cache-Control "no-cache";
    }

    location /api/ {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
        set $upstream ${API_UPSTREAM};
        proxy_pass http://$upstream;
        proxy_read_timeout 120s;
    }
}
